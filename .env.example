# Copy to .env.local. Every value is optional — features without config hide themselves.

# GitHub contribution graph (private contributions). Falls back to public data.
GITHUB_TOKEN=

# Spotify: now playing, recently played, song mood.
# Get a refresh token: node scripts/spotify-refresh-token.mjs <CLIENT_ID> <CLIENT_SECRET>
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Supabase Realtime: live "people viewing now" faces.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
